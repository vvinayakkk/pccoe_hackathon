# =============================================================================
# PIISAFE Environment Variables
# =============================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Database Configuration
MONGO_URI=mongodb://admin:password123@localhost:27017/
DATABASE_NAME=TCET2
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# API URLs
REACT_APP_API_URL=http://localhost:5000
REACT_APP_DASHBOARD_API_URL=http://localhost:5001
REACT_APP_GUARDIAN_API_URL=http://localhost:5002
VUE_APP_API_URL=http://localhost:5002

# Anushka Microservices URLs
GMAIL_AUTH_SERVICE_URL=http://localhost:3000
TASK_SERVICE_URL=http://localhost:3001
ANALYTICS_SERVICE_URL=http://localhost:3002

# Translation API Configuration (backend1)
AUTHORIZATION_TOKEN=your_bhashini_authorization_token_here
DEFAULT_SERVICE_ID=ai4bharat/indictrans--gpu-t4
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in

# Anushka Microservices Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
COMPOSIO_API_KEY=your_composio_api_key_here

# External Services
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# File Storage
FILE_STORAGE_PATH=/app/public/uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Performance
WORKERS=4
THREADS=2
TIMEOUT=30

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Development
DEBUG_MODE=true
ENABLE_HOT_RELOAD=true

# Production (set these in production)
# FLASK_ENV=production
# FLASK_DEBUG=0
# DEBUG_MODE=false
# ENABLE_HOT_RELOAD=false
